      <w:tr><w:tc><w:p><w:r><w:t>Capacity</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>IE 标准产能，由视图回退逻辑引用</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>DayUpperCapacity</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>产品+工序当日产量上限</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>ReplyDate</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>采购物料复期，物料级硬约束</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>PCDeliveryDate</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>计划员要求开工日，仅排序</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>Extend16</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>销售单号备注，工序链分组键</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>Priority</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>工序顺序，全量重算排序用</w:t></w:r></w:p></w:tc></w:tr>
    </w:tbl>
    <w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>A.2 工序衔接天数（存储过程逻辑）</w:t></w:r></w:p>
    <w:p><w:r><w:t>SuggestedStartDate = 前道 StartDate + CASE WHEN PhaseR=1 OR 下道CHAIN_ORD=4 THEN 1 ELSE 0 END</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>PhaseR=1：当前轮为贴片（SMT）→ 下道 +1 天</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>MinNext.NextChainOrd=4：组内下一道为组装（包装按此判断）→ 下道 +1 天</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>其余：+0 天（当天衔接）</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>A.3 计算公式</w:t></w:r></w:p>
    <w:p><w:r><w:t>有效产能 = 视图.PCCapacity × 产能系数（PCCapacity 空→Capacity 在视图中完成）</w:t></w:r></w:p>
    <w:p><w:r><w:t>单日理论数量 = 有效产能 × 剩余工时 × 上班人数</w:t></w:r></w:p>
    <w:p><w:r><w:t>占用工时 = 当日计划数量 / 有效产能 / 上班人数</w:t></w:r></w:p>
    <w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t>A.4 已知待确认项</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>工序链分组：销售单号 vs 生产订单号，待客户确认。</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>同销售单多成品、拆生产订单、有库存不生产时链条可能不清晰。</w:t></w:r></w:p>
    <w:p><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr></w:pPr><w:r><w:t>钢网产能：无数据，仅前端颜色提示。</w:t></w:r></w:p>

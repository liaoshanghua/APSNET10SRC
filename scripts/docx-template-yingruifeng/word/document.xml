      <w:tr><w:tc><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>字段</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>含义</w:t></w:r></w:p></w:tc></w:tr>
      <w:tr><w:tc><w:p><w:r><w:t>OWEQTY</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>未完成数/待排数，已扣 HasQty</w:t></w:r></w:p></w:tc></w:tr>

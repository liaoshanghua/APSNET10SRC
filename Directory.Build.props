<!--
  EasyManufacture.Net10 解决方案级 MSBuild 属性。
  作用于 src 下所有可打包类库（Domain / Application / Licence / Infrastructure）。
  Api 宿主项目单独设置 IsPackable=false。
-->
<Project>
  <PropertyGroup>
    <!-- NuGet 包版本前缀；独立宿主 EasyManufacture.Api 中 EasyManufacturePackageVersion 需与此保持一致 -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>EasyManufacture</Authors>
    <Company>EasyManufacture</Company>
    <Product>EasyManufacture</Product>
    <Description>EasyManufacture .NET 10 运行时库</Description>
    <!-- 本地 NuGet 输出目录；由 scripts/Pack-Libraries.ps1 写入，供 EasyManufacture.Api 引用 -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
</Project>
